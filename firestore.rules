
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // A user can get and create their own document.
      allow get, create: if request.auth != null && request.auth.uid == userId;

      // A user can update their own document, but not protected fields.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'subscriptionStatus', 'subscriptionId', 'subscriptionInterval',
          'subscriptionCurrentPeriodEnd', 'proposalCredits', 'referredBy',
          'referralCode', 'referralBonusAwarded', 'lastPrice',
          'upgradeBonusGiven', 'trialCreditsAwarded'
        ]);

      // Nobody can delete user documents from the client.
      allow delete: if false;
      
      // Allow any authenticated user to list the users collection, 
      // but the 'get' rule above prevents them from reading individual documents.
      allow list: if request.auth != null;
    }

    // --- SUBCOLLECTIONS ---
    match /users/{userId}/{collection}/{docId} {
      // Users can perform any action on documents in their own subcollections.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
